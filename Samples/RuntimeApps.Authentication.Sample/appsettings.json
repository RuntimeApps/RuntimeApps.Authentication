{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Authentication": "Data Source=authentication.db"
  },
  "Authentication": {
    "Jwt": {
      "SaveToken": false,
      "RequireHttpsMetadata": true,
      "RefreshInterval": "00:16:40",
      "TokenValidationParameters": {
        "ValidateIssuerSigningKey": true,
        "ValidateIssuer": false,
        "ValidIssuer": "Runtime Apps Authentication Sample",
        "ValidateAudience": true,
        "ValidAudience": "Runtime Apps Authentication Sample",
        "ValidateLifetime": true,
        "ClockSkew": "00:00:00",
        "RequireExpirationTime": true
      }
    },
    "Verification": {
      "CodeLength": 7,
      "CodeLifetime": "00:10:00",
      "MaximumFailedAttempts": 5,
      "ResendCooldown": "00:01:00",
      "MaximumSendsPerHour": 5,
      "RequireEmailVerificationForExternalLogins": false,
      "Smtp": {
        "Host": "localhost",
        "Port": 1025,
        "SocketOptions": "None",
        "FromAddress": "noreply@example.com",
        "FromName": "RuntimeApps Authentication Sample"
      }
    },
    "ExternalLogin": {
      "Google": { "EmailTrust": "Verified" },
      "Facebook": { "EmailTrust": "Always" },
      "Microsoft": { "EmailTrust": "Never" }
    },
    "ForgotPassword": {
      "Method": "VerificationCode"
    },
    "RefreshTokens": {
      "TokenLifetime": "30.00:00:00",
      "RevokeFamilyOnReuse": true,
      "RefreshRequestsPerMinute": 30
    }
  }
}
